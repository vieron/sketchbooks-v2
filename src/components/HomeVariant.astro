---
import type { SketchMeta } from '../data/sketches';

interface Props {
  sketches: SketchMeta[];
}

const { sketches } = Astro.props;

const meta = {
  kicker: 'visual experiments / generative tools',
  title: 'generative sketches',
  summary:
    'Parametric studies in type, shape, motion, and procedural drawing for the browser.',
  note: 'Tools for shaping procedural graphics directly in the browser, with SVG exports ready for graphics software.',
};

const figureSketches = [...sketches].reverse();
---

<main class="home-variant">
  <nav class="home-variant__nav" aria-label="Primary">
    <a href="/" class="home-variant__brand">sketchbooks</a>
  </nav>

  <section class="home-variant__hero" aria-labelledby="home-title">
    <p class="home-variant__kicker">{meta.kicker}</p>
    <h1 id="home-title">{meta.title}</h1>
    <p class="home-variant__summary">{meta.summary}</p>
    <p class="home-variant__note">{meta.note}</p>
  </section>

  <ol class="home-variant__list" aria-label="Sketch archive">
    {
      figureSketches.map((sketch) => (
        <li class="home-variant__item">
          <a href={sketch.href} class="home-variant__item-link">
            <span class="home-variant__item-number">{sketch.number}</span>
            <span class="home-variant__item-title">{sketch.title}</span>
            <span class="home-variant__item-medium">{sketch.medium}</span>
            <span class="home-variant__item-description">
              {sketch.description}
            </span>
            <figure class="home-variant__thumb">
              {sketch.image && (
                <img
                  src={sketch.image}
                  alt={`${sketch.title} generated preview`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="home-variant__cursor-circle" aria-hidden="true" />
            </figure>
          </a>
        </li>
      ))
    }
  </ol>

  <footer class="home-variant__footer">
    <p>sketchbooks</p>
    <p>
      made by <a href="https://vieron.net" target="_blank" rel="noreferrer">vieron</a>
    </p>
    <p>2026</p>
  </footer>
</main>

<style>
  .home-variant {
    --variant-paper: #ffffff;
    --variant-ink: #151411;
    --variant-muted: #686052;
    --variant-line: #cfc5b3;
    --variant-electric-blue: var(--electric-blue);
    --variant-accent: var(--variant-electric-blue);
    --variant-thumb: #151411;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr;
    gap: clamp(1.5rem, 3vw, 3.2rem);
    padding: clamp(1rem, 2.5vw, 2.5rem);
    background: var(--variant-paper);
    color: var(--variant-ink);
  }

  .home-variant__nav,
  .home-variant__kicker,
  .home-variant__summary,
  .home-variant__note,
  .home-variant__footer,
  .home-variant__item-number,
  .home-variant__item-medium,
  .home-variant__item-description {
    font-family: var(--mono);
    font-size: 0.64rem;
    line-height: 1.45;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-variant__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--variant-line);
    color: var(--variant-muted);
  }

  .home-variant__brand,
  .home-variant__item-link {
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .home-variant__brand:hover,
  .home-variant__item-link:hover,
  .home-variant__item-link:focus-visible {
    color: var(--variant-accent);
  }

  .home-variant__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.35fr);
    align-items: end;
    gap: 1rem 1.5rem;
  }

  .home-variant__hero h1 {
    max-width: 9.6ch;
    margin: 0;
    padding-top: 0.12em;
    font-family: var(--display);
    font-size: clamp(5.4rem, 12.2vw, 12.5rem);
    font-weight: 700;
    line-height: 0.61;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-variant__kicker {
    grid-column: 1 / -1;
  }

  .home-variant__kicker,
  .home-variant__summary,
  .home-variant__note {
    margin: 0;
    color: var(--variant-muted);
  }

  .home-variant__summary {
    justify-self: end;
    max-width: 26rem;
  }

  .home-variant__note {
    max-width: 25rem;
  }

  .home-variant__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: clamp(2.2rem, 4vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-variant__footer {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--variant-line);
    color: var(--variant-muted);
  }

  .home-variant__footer p {
    margin: 0;
  }

  .home-variant__footer a {
    color: inherit;
    transition: color 180ms ease;
  }

  .home-variant__footer a:hover,
  .home-variant__footer a:focus-visible {
    color: var(--variant-electric-blue);
  }

  .home-variant__item-link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.45rem 0.85rem;
    padding: 0;
    color: inherit;
  }

  .home-variant__item-title {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .home-variant__item-number,
  .home-variant__item-medium,
  .home-variant__item-description {
    color: var(--variant-muted);
  }

  .home-variant__item-medium {
    grid-column: 2 / 3;
    margin-top: 0.2rem;
  }

  .home-variant__item-description {
    grid-column: 2 / 3;
    max-width: 26rem;
  }

  .home-variant__thumb {
    --cursor-x: -4rem;
    --cursor-y: -4rem;
    grid-column: 1 / -1;
    order: -1;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    margin: 0 0 0.65rem;
    border: 1px solid var(--variant-line);
    background: var(--variant-thumb);
    cursor: none;
    transition: border-color 180ms ease;
  }

  .home-variant__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.88) contrast(1.05);
  }

  .home-variant__cursor-circle {
    position: absolute;
    left: var(--cursor-x);
    top: var(--cursor-y);
    z-index: 2;
    width: clamp(1.3rem, calc(1.55vw + 10px), 2.2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffffff;
    mix-blend-mode: difference;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.86);
    transition:
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .home-variant__thumb:hover .home-variant__cursor-circle {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .home-variant__thumb:hover,
  .home-variant__item-link:focus-visible .home-variant__thumb {
    border-color: var(--variant-ink);
  }

  @media (max-width: 980px) {
    .home-variant {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 1.5rem;
    }

    .home-variant__hero {
      grid-template-columns: 1fr;
    }

    .home-variant__summary {
      justify-self: start;
    }

    .home-variant__list {
      gap: 1.5rem;
    }
  }

  @media (max-width: 620px) {
    .home-variant {
      padding: 1rem;
    }

    .home-variant__nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-variant__hero h1 {
      font-size: clamp(4.9rem, 24vw, 6.4rem);
      line-height: 0.62;
    }

    .home-variant__list {
      grid-template-columns: 1fr;
    }

    .home-variant__item-link {
      grid-template-columns: 2.8rem minmax(0, 1fr);
    }

    .home-variant__footer {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const cursorThumbs =
    document.querySelectorAll<HTMLElement>('.home-variant__thumb');

  cursorThumbs.forEach((thumb) => {
    thumb.addEventListener('pointermove', (event) => {
      const rect = thumb.getBoundingClientRect();
      thumb.style.setProperty('--cursor-x', `${event.clientX - rect.left}px`);
      thumb.style.setProperty('--cursor-y', `${event.clientY - rect.top}px`);
    });

    thumb.addEventListener('pointerleave', () => {
      thumb.style.setProperty('--cursor-x', '-4rem');
      thumb.style.setProperty('--cursor-y', '-4rem');
    });
  });
</script>
