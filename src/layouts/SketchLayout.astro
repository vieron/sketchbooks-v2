---
import BaseLayout from './BaseLayout.astro';
import type { SketchMeta } from '../data/sketches';

interface Props {
  sketch: SketchMeta;
}

const { sketch } = Astro.props;
---

<BaseLayout title={sketch.title} description={sketch.description}>
  <main class="sketch-page">
    <header class="sketch-page__header">
      <a href="/" aria-label="Back to sketchbooks gallery">sketchbooks</a>
      <p>{sketch.number} / {sketch.medium}</p>
    </header>
    <slot />
  </main>
</BaseLayout>
