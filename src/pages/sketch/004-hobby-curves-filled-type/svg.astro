---
import SketchLayout from '../../../layouts/SketchLayout.astro';
import { getSketchById } from '../../../data/sketches';
import HobbyCurvesFilledType from './_HobbyCurvesFilledType';

const sketch = getSketchById('hobby-curves-filled-type');
if (!sketch) throw new Error('Missing sketch metadata');
---

<SketchLayout sketch={{ ...sketch, title: `${sketch.title} SVG`, medium: 'svg / hobby curves' }}>
  <HobbyCurvesFilledType client:only="react" />
</SketchLayout>
